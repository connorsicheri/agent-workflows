#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$SOURCE_DIR/$TARGET"
  fi
done

COMPASS_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
AGENT="compass-orchestrator"
COMPASS_LABEL="Compass"
STATUS_LINE_SETTINGS='{"statusLine":{"type":"command","command":"\"${COMPASS_CLAUDE_ROOT}/scripts/compass-statusline.sh\"","refreshInterval":5}}'

usage() {
  cat <<'EOF'
Usage: compass [advanced] [--print-launch] [claude args...]

Start a Claude Code Compass session from this plugin checkout.

Commands:
  advanced        Start with compass-advanced-orchestrator.
  --print-launch Print the Claude command instead of executing it.
EOF
}

if [[ "${1:-}" == "advanced" ]]; then
  AGENT="compass-advanced-orchestrator"
  COMPASS_LABEL="Compass advanced"
  shift
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--print-launch" ]]; then
  printf 'COMPASS_CLAUDE_ROOT=%q COMPASS_CLAUDE_LABEL=%q claude --plugin-dir %q --agent %q --settings %q' \
    "$COMPASS_DIR" "$COMPASS_LABEL" "$COMPASS_DIR" "compass:$AGENT" "$STATUS_LINE_SETTINGS"
  shift
  for arg in "$@"; do
    printf ' %q' "$arg"
  done
  printf '\n'
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  printf 'error: Claude Code CLI not found on PATH: claude\n' >&2
  exit 127
fi

export COMPASS_CLAUDE_ROOT="$COMPASS_DIR"
export COMPASS_CLAUDE_LABEL="$COMPASS_LABEL"
exec claude --plugin-dir "$COMPASS_DIR" --agent "compass:$AGENT" \
  --settings "$STATUS_LINE_SETTINGS" "$@"
