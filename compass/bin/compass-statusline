#!/usr/bin/env node
'use strict';

const path = require('path');

let input = '';

process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => {
  input += chunk;
});

process.stdin.on('end', () => {
  let payload;

  try {
    payload = JSON.parse(input || '{}');
  } catch {
    return;
  }

  const columns = clamp(Number(process.env.COLUMNS) || 100, 40, 200);
  const agent = formatAgent(payload.agent?.name);
  const model = clean(payload.model?.display_name || payload.model?.id || 'model');
  const cwd = path.basename(clean(payload.workspace?.current_dir || payload.cwd || '')) || 'workspace';
  const context = formatPercent(payload.context_window?.used_percentage, 'ctx');
  const limit = formatPercent(payload.rate_limits?.five_hour?.used_percentage, '5h');
  const cost = formatCost(payload.cost?.total_cost_usd);
  const pr = payload.pr?.number ? `PR #${payload.pr.number}` : '';

  const left = `Compass ${agent}`;
  const right = [model, cwd, context, limit, cost, pr].filter(Boolean).join(' | ');
  const content = right ? `${left} | ${right}` : left;

  process.stdout.write(`${truncate(content, columns)}\n`);
});

function formatAgent(raw) {
  const value = clean(raw).replace(/^compass:/, '');
  const aliases = {
    'compass-advanced-orchestrator': 'advanced',
    'compass-orchestrator': 'orchestrator',
  };

  return aliases[value] || value.replace(/^compass-/, '') || 'active';
}

function formatPercent(raw, label) {
  const value = Number(raw);
  if (!Number.isFinite(value)) return '';
  return `${label} ${Math.max(0, Math.min(100, Math.round(value)))}%`;
}

function formatCost(raw) {
  const value = Number(raw);
  if (!Number.isFinite(value) || value <= 0) return '';
  if (value < 1) return `$${value.toFixed(3)}`;
  return `$${value.toFixed(2)}`;
}

function clean(value) {
  return String(value ?? '').replace(/\s+/g, ' ').trim();
}

function truncate(value, width) {
  const text = clean(value);
  if (text.length <= width) return text;
  if (width <= 3) return '.'.repeat(Math.max(width, 0));
  return `${text.slice(0, width - 3)}...`;
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}
